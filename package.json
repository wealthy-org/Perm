{
  "name": "perm-interface",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:test:fork": "RUN_FORK_TESTS=1 hardhat test contracts/test/PermV4Fork.test.cjs",
    "contracts:deploy:testnet": "hardhat run contracts/scripts/deploy.cjs --network robinhoodTestnet",
    "check": "tsc --noEmit && hardhat test && next build",
    "contracts:export": "hardhat compile && node contracts/scripts/export-artifacts.cjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "postcss": "8.5.33",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "three": "0.169.0",
    "viem": "2.58.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@openzeppelin/contracts": "5.6.1",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "^22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@types/three": "0.169.0",
    "@uniswap/v4-core": "1.0.2",
    "chai": "4.5.0",
    "ethers": "6.15.0",
    "hardhat": "2.29.2",
    "ts-node": "10.9.2",
    "typescript": "^5.7.2"
  }
}
