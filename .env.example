# Runtime RPC. Use dedicated primary/fallback providers for public traffic.
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_TESTNET_FALLBACK_RPC_URL=
# Optional archive-only pin. Leave unset to fork the latest public state.
FORK_BLOCK_NUMBER=

# Shared addresses normally come from deployments/robinhood-testnet.json.
# Staging overrides remain fail-closed unless execution readiness is explicit.
NEXT_PUBLIC_PERM_ROUTER_ADDRESS=
NEXT_PUBLIC_PERM_V4_ADAPTER_ADDRESS=
NEXT_PUBLIC_PERM_V3_ADAPTER_ADDRESS=
NEXT_PUBLIC_PERM_ROUTER_VERSION=
NEXT_PUBLIC_PERM_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_PERM_EXECUTION_READY=0
# Controlled candidate staging only; JSON array matching docs/HOOK_ONBOARDING.md.
PERM_AGGREGATOR_HOOKS_JSON=

# Quote authorization. Shared releases require authenticated remote KMS/HSM signing.
PERM_QUOTE_SIGNER_MODE=local
PERM_QUOTE_SIGNER_URL=
PERM_QUOTE_SIGNER_TOKEN=
PERM_QUOTE_SIGNER_PRIVATE_KEY=
QUOTE_SIGNER_ADDRESS=
# Rehearsal-only derivation; shared deployment rejects it.
QUOTE_SIGNER_PRIVATE_KEY=

# Optional WalletConnect QR sessions (injected wallets work without it).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Durable indexed history and shared serverless rate limiting (PostgreSQL).
# Production must set both fail-closed flags after running indexer/schema.sql.
DATABASE_URL=
PERM_INDEXER_DATABASE_URL=
PERM_RATE_LIMIT_DATABASE_URL=
PERM_REQUIRE_INDEXER=0
PERM_REQUIRE_SHARED_RATE_LIMIT=0
RECEIPT_MIN_CONFIRMATIONS=12
HISTORY_CONFIRMATIONS=12
INDEXER_CONFIRMATIONS=12
INDEXER_REORG_DEPTH=100
INDEXER_CHUNK_SIZE=10000
INDEXER_DB_POOL_SIZE=3
INDEXER_POLL_MS=15000
INDEXER_WATCH=0
PGSSLMODE=require

# Deployment only. Never commit/reuse keys and never fund them with mainnet assets.
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=
TREASURY_ADDRESS=
PAUSE_GUARDIAN_ADDRESS=
TIMELOCK_PROPOSER_ADDRESS=
TIMELOCK_DELAY_SECONDS=172800
VERIFY=0
DEPLOYMENT_OUTPUT=
RELEASE_COMMIT_SHA=

# Candidate release gates. Values are intentionally explicit to prevent accidental promotion.
CANDIDATE_MANIFEST=deployments/robinhood-testnet.v2-candidate.json
HOOK_EVIDENCE_CONFIRMATIONS=12
E2E_EVIDENCE_CONFIRMATIONS=12
MAX_GAS_ESTIMATE_ERROR_BPS=3000
WALLETCONNECT_QA_SIGNERS=
# Comma-separated EOA trust roots used to verify signed release attestations.
RELEASE_AUDITOR_SIGNERS=
RELEASE_INCIDENT_SIGNERS=
RELEASE_BUG_BOUNTY_SIGNERS=
RELEASE_CUSTODY_ATTESTERS=
RELEASE_ENGINEERING_APPROVERS=
RELEASE_SECURITY_APPROVERS=
RELEASE_GOVERNANCE_APPROVERS=
RELEASE_OPERATIONS_APPROVERS=
PERM_STAGING_URL=
RELEASE_TEST_ACCOUNT=
# Address-only inputs for the focused real KMS/HSM custody probe.
RELEASE_SIGNER_PROBE_ACCOUNT=
RELEASE_SIGNER_PROBE_TOKEN_IN=
RELEASE_SIGNER_PROBE_TOKEN_OUT=
RELEASE_QUOTE_TOKEN_IN=ETH
RELEASE_QUOTE_TOKEN_OUT=NVDA
RELEASE_QUOTE_AMOUNT_IN=1000000000000
CONFIRM_ALERT_WEBHOOK_TEST=
CONFIRM_PROMOTION=
CONFIRM_ROUTER_ADDRESS=

# Monitoring and pool operations.
PERM_ALERT_WEBHOOK_URL=
PERM_STRICT_OPERATIONS=0
MONITOR_ALERT_WARNINGS=0
MONITOR_MAX_BLOCK_LAG_SECONDS=900
MONITOR_MAX_INDEXER_BLOCK_LAG=300
MONITOR_MAX_INDEXER_TIME_LAG_SECONDS=900
PERM_VERIFIED_HOOKS=
POOL_DISCOVERY_CONFIRMATIONS=12
POOL_DISCOVERY_REORG_DEPTH=100
POOL_DISCOVERY_CHUNK=10000
POOL_DISCOVERY_FROM_BLOCK=
POOL_DISCOVERY_RESET=0
