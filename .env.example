# Public Robinhood Chain testnet endpoint. Use a dedicated provider for public/high-volume hosting.
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Reproducible fork fixture; override intentionally when refreshing integration evidence.
FORK_BLOCK_NUMBER=154719917

# Browser-visible addresses are normally read from deployments/robinhood-testnet.json.
# These overrides are useful for a staging deployment.
NEXT_PUBLIC_PERM_ROUTER_ADDRESS=
NEXT_PUBLIC_PERM_V4_ADAPTER_ADDRESS=

# Deployment only. Never commit a real key and never use a wallet holding mainnet funds.
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=
TREASURY_ADDRESS=

# Public site metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
